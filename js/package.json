{
  "version": "1.2.1",
  "description": "Generate UCP-compliant servers for merchants from a simple schema",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ucpify": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "ts-node src/cli.ts",
    "init": "ts-node src/cli.ts init",
    "serve": "ts-node src/cli.ts serve",
    "validate": "ts-node src/cli.ts validate",
    "test": "node -e \"JSON.parse(require('fs').readFileSync('package.json','utf8'))\"",
    "test:watch": "vitest"
  },
  "keywords": [
    "ucp",
    "commerce",
    "checkout",
    "agentic",
    "ai-commerce"
  ],
  "author": "Hemanth HM <hemanth@h3manth.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hemanth/ucpify.git"
  },
  "homepage": "https://github.com/hemanth/ucpify#readme",
  "type": "commonjs",
  "dependencies": {
    "@paypal/paypal-server-sdk": "^2.5.0",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "pino": "^10.4.0",
    "stripe": "^23.0.0",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^11.0.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "name": "ucpify"
}
